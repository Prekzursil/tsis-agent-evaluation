#!/usr/bin/env bash
# Canonical local verification entry point (fleet standard: BEST-CONFIG §5).
#
# Mirrors what CI enforces on every PR, with the same config files:
#   quality  -> ruff check + ruff format --check + basedpyright (standard)
#   tsis-ci  -> compile-check of every tracked .py
#            + pytest --cov --cov-branch with fail_under = 100
#              (enforced by pyproject.toml [tool.coverage.report])
#
# The pinned-binary lanes (gitleaks 8.30.1, opengrep v1.32.0, osv-scanner
# v2.3.8 at deps-severity-floor: any) are verified in CI via
# .github/workflows/quality.yml; this script is their local proxy for
# everything installable from requirements.txt.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${PYTHON:-python3}"

cd "$ROOT_DIR"

# Gate 1 + 2: lint, format, types.
"$PYTHON_BIN" -m ruff check .
"$PYTHON_BIN" -m ruff format --check .
"$PYTHON_BIN" -m basedpyright

# Compile-check every tracked .py, one file at a time so a failure names
# itself (same policy as the tsis-ci workflow; note CI legs run py3.10 and
# py3.12 — run with a 3.10 interpreter to catch version-specific syntax).
git ls-files '*.py' | while IFS= read -r f; do
  "$PYTHON_BIN" -m py_compile "$f"
done

# Gate 3: tests + STRICT 100% line+branch coverage.
"$PYTHON_BIN" -m pytest --cov --cov-branch -q
